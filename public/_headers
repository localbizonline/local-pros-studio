# Files whose names change whenever their content does (Vite's /assets) or that we rename on change
# (/fonts): browsers keep them for a year instead of re-downloading on every visit (9 Oct 2026).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Unlisted page, shared only by link (14 Oct 2026): the same noindex, nofollow as its robots meta tag
/lead-partners
  X-Robots-Tag: noindex, nofollow
/lead-partners.html
  X-Robots-Tag: noindex, nofollow
# Unlisted swipe deck for lead partners (16 Oct 2026), a static file in public/lead-partners/
/lead-partners/intro
  X-Robots-Tag: noindex, nofollow
/lead-partners/intro.html
  X-Robots-Tag: noindex, nofollow
